# Responsible: set dedicated RPCs before LIVE size.
# Master LIVE switch (quotes + SOL Jupiter swap-tx). Off until exactly 1.
GMGN_LIVE=0

# Separate broadcast opt-in; keep disabled until live trading is authorized.
GMGN_SOL_BROADCAST=0

# Max native per quote/swap (SOL). Default 0.05 if unset.
GMGN_MAX_NATIVE_AMOUNT=0.05

# Tracked wallet limits (defaults: 0.1 SOL total exposure, 5 open mints).
GMGN_MAX_PORTFOLIO_SOL=0.1
GMGN_MAX_OPEN_POSITIONS=5

# Max Jupiter slippage in basis points (default 300 = 3%).
GMGN_MAX_SLIPPAGE_BPS=300

# Max Jupiter price impact percent for SOL quote/swap/close (default 5).
GMGN_MAX_PRICE_IMPACT_PCT=5

# Optional dedicated Solana RPC for mint-safety (server).
# SOLANA_RPC_URL=https://your-rpc

# Optional Solana RPC for the browser (set in Vite env as VITE_SOLANA_RPC_URL).
# VITE_SOLANA_RPC_URL=https://your-helius-or-quicknode-url

# Per-process budget for read-only holdings quotes (default 40 requests/minute).
GMGN_PNL_QUOTES_PER_MIN=40

# Optional Jupiter API base (default lite-api).
# JUPITER_API_BASE=https://lite-api.jup.ag/swap/v1

# Generated on first server start if missing. Paste into Credentials.
# GMGN_LOCAL_TOKEN=

# Optional: GMGN API key/wallet only for legacy non-SOL quote path.
# Do NOT set GMGN_PRIVATE_KEY — rejected.
# GMGN_API_KEY=
# GMGN_WALLET_ADDRESS=

# RugCheck normalised score ceiling (higher = riskier). Default 40.
GMGN_MAX_RUG_SCORE=40
# Minimum RugCheck totalMarketLiquidity USD when markets exist. Default 1000.
GMGN_MIN_LIQUIDITY_USD=1000
