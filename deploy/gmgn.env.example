# Server settings for the trading app. Install as /etc/gmgn-trader/gmgn.env, owned by root,
# group gmgn, mode 640, so only root can edit it and only the app can read it.
# Never commit the real file.

# Second lock: the app token. Make one with:  openssl rand -base64 36
# Production refuses to start without it (minimum 32 characters).
GMGN_LOCAL_TOKEN=

# Keep both switches at 0. LIVE trading needs a separate, deliberate decision.
GMGN_LIVE=0
GMGN_SOL_BROADCAST=0

# Sign-in. Only these emails may sign up or sign in (comma-separated).
GMGN_ALLOWED_EMAILS=
# Keep at 0. Set to 1 only while you create your first account, then back to 0.
GMGN_SIGNUP_OPEN=0
# The https:// address you open the app at (your domain). Needed for Google and Apple sign-in.
GMGN_PUBLIC_URL=https://trader.example.com
# Optional Google sign-in (both or neither).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional Apple sign-in (all four or none). The service cannot read /home, so keep the key here.
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/etc/gmgn-trader/AuthKey.p8

# Databases live outside the app folder so the app folder can stay read-only.
GMGN_AUTH_DB_PATH=/var/lib/gmgn-trader/auth.sqlite
GMGN_TRADE_LEDGER_PATH=/var/lib/gmgn-trader/broadcast-journal.json
GMGN_PORTFOLIO_LEDGER_PATH=/var/lib/gmgn-trader/portfolio.sqlite
GMGN_RESEARCH_DB_PATH=/var/lib/gmgn-trader/research.sqlite
GMGN_LIVE_TRADES_PATH=/var/lib/gmgn-trader/live-trades.sqlite

# Optional secrets file (GMGN_API_KEY, GMGN_WALLET_ADDRESS, Google values). The service cannot read /home.
GMGN_SECRETS_PATH=/etc/gmgn-trader/secrets.json

# Optional dedicated Solana RPC (keeps its API key on the server; the browser uses the app's proxy).
# SOLANA_RPC_URL=

# Limits (defaults shown).
GMGN_MAX_NATIVE_AMOUNT=0.05
GMGN_MAX_PORTFOLIO_SOL=0.1
GMGN_MAX_OPEN_POSITIONS=5
GMGN_API_REQUESTS_PER_MIN=300
GMGN_AUTH_FAILURES_PER_15_MIN=10
