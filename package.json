{
  "name": "gmgn-ai-trader-replica",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "concurrently -k -n web,api -c lime,cyan \"npm run dev -- --host 127.0.0.1 --port 5173\" \"npm run server\"",
